# URL pública del sitio (usada en canonical, Open Graph, sitemap y robots)
NEXT_PUBLIC_SITE_URL=https://bubolegal.vercel.app

# Número de WhatsApp Business en formato internacional sin "+"
NEXT_PUBLIC_WHATSAPP_NUMBER=573001234567

# Envío de correos del formulario de contacto (https://resend.com)
RESEND_API_KEY=
CONTACT_FROM_EMAIL="BUBO Legal <contacto@bubolegal.com>"
CONTACT_TO_EMAIL=contacto@bubolegal.com

# Mapa de la oficina. Sin esta clave se usa el embed público de Google Maps.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Analítica (opcional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
